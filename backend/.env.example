# Copy to backend/.env for local development. backend/.env is gitignored.

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://cassandra:cassandra@localhost:5432/cassandra?sslmode=disable

# Anthropic credentials — provide ONE of the following (or leave TESTING=True to stub):
#   * A standard API key (sent as x-api-key):
# ANTHROPIC_API_KEY=sk-ant-...
#   * OR a bearer token for a gateway/base-URL setup (sent as Authorization: Bearer,
#     with the oauth beta header added automatically). Often set in your shell already:
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://your-gateway/...

# HTTP port the Go server listens on
PORT=8082

# gin mode: debug | release | test  (blank = gin default, which is debug)
GIN_MODE=debug

# Allowed browser origin (informational; the API sits behind the SvelteKit BFF)
FRONTEND_ORIGIN=http://localhost:5173

# Set to "True" to stub the AI interpretation (used by tests and offline dev)
TESTING=
